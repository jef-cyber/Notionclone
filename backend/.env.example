# Copy to .env and fill in real values. Never commit .env.

# MongoDB connection string. The database name here is the only one the app uses.
MONGODB_URI=mongodb://127.0.0.1:27017/lumen

# Signing key for session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a session token stays valid.
JWT_EXPIRES_IN=7d

# Port for both the JSON API and the static frontend.
PORT=4000

# Allowed browser origin. Only needed when the frontend is served separately
# from the API; same-origin requests ignore it.
CORS_ORIGIN=*

# Set to true to log every request.
LOG_REQUESTS=false
